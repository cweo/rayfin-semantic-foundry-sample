# Optional public settings. Copy to .env; never store an API key here.
# Endpoint/deployment may also be entered through the Foundry settings gear.
VITE_OPENAI_ENDPOINT=
VITE_OPENAI_DEPLOYMENT=

# Setup selects the Fabric workspace, Lakehouse and table interactively.
# All generated identifiers and deployment records stay in .fabric-deployment/.
# No Entra SPA registration, MSAL settings or GraphQL endpoint is required.
